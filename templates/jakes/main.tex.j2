%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1\vspace{\VAR{layout.item_gap}pt}}% no space before \vspace: a full-width bullet would otherwise leave a blank line
  }
}

\newcommand{\classesList}[4]{
    \item\small{
        {#1 #2 #3 #4 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{\VAR{layout.heading_gap}pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.001\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{\VAR{layout.list_gap}pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{document}

%% Resume Tailor fills in the parts marked VAR / BLOCK from data/experiences.yaml.
%% layout.* are spacing knobs the one-page optimizer may nudge within safe bounds (defaults = original look).

%----------HEADING----------
\begin{center}
    {\Huge \scshape \VAR{p.first_name} \VAR{p.last_name}} \\ \vspace{1pt}
    \small \raisebox{-0.1\height}\faPhone\ \VAR{p.phone} ~
    \href{mailto:\VAR{p.email_raw}}{\raisebox{-0.2\height}\faEnvelope\ \underline{\VAR{p.email}}}\BLOCK{for l in p.links} ~
    \href{\VAR{l.url_raw}}{\BLOCK{if l.icon}\raisebox{-0.2\height}\VAR{l.icon}\ \BLOCK{endif}\underline{\VAR{l.label}}}\BLOCK{endfor}

    \vspace{-8pt}
\end{center}

%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
\BLOCK{for e in education}
    \resumeSubheading
      {\VAR{e.school}}{\VAR{e.location}}
      {\VAR{e.degree}}{\VAR{e.dates}}
\BLOCK{if e.bullets}
      \resumeItemListStart
\BLOCK{for b in e.bullets}
        \resumeItem{\VAR{b}}
\BLOCK{endfor}
      \resumeItemListEnd
\BLOCK{endif}
\BLOCK{endfor}
  \resumeSubHeadingListEnd

\BLOCK{if experiences}
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
\BLOCK{for x in experiences}
    \resumeSubheading
      {\VAR{x.title}}{\VAR{x.dates}}
      {\VAR{x.org}}{\VAR{x.location}}
      \resumeItemListStart
\BLOCK{for b in x.bullets}
        \resumeItem{\VAR{b}}
\BLOCK{endfor}
      \resumeItemListEnd
\BLOCK{endfor}
  \resumeSubHeadingListEnd
\BLOCK{endif}

\BLOCK{if projects}
%-----------PROJECTS-----------
\section{Projects}
    \vspace{-5pt}
    \resumeSubHeadingListStart
\BLOCK{for x in projects}
      \resumeProjectHeading
          {\textbf{\VAR{x.title}}\BLOCK{if x.url} \href{\VAR{x.url}}{$\nearrow$}\BLOCK{endif} $|$ \emph{\VAR{x.stack}}}{\VAR{x.dates}}
          \resumeItemListStart
\BLOCK{for b in x.bullets}
            \resumeItem{\VAR{b}}
\BLOCK{endfor}
          \resumeItemListEnd
\BLOCK{if not loop.last}
          \vspace{-13pt}
\BLOCK{endif}
\BLOCK{endfor}
    \resumeSubHeadingListEnd
\vspace{-13pt}
\BLOCK{endif}

\BLOCK{if skills}
%-----------TECHNICAL SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
\BLOCK{for s in skills}
     \textbf{\VAR{s.category}}{: \VAR{s.list}} \\
\BLOCK{endfor}
    }}
 \end{itemize}
 \vspace{-16pt}
\BLOCK{endif}

\end{document}
