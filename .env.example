# How bullets get picked:
#   claude-code  (default) Claude Code signed in with your Claude plan. Uses plan usage, no API bill.
#   local        On-device meaning match (bge-small via fastembed, ~67 MB, downloads once). No Claude at all.
#   offline      Free keyword matcher. No Claude at all.
#   api          Paid Anthropic API. Only if you set ANTHROPIC_API_KEY below.
ENGINE=claude-code

# Model for claude-code. haiku is lightest on your plan's usage; sonnet picks a bit better.
CLAUDE_CODE_MODEL=haiku

# Only for ENGINE=api
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# PORT=8765
